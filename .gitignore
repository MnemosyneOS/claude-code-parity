# Files this plugin writes at runtime, plus the usual noise.
.runtime/
__pycache__/
*.py[cod]
*.egg-info/
node_modules/
.venv/
venv/

# Local machine state that must never be published
*.log
.env
.env.*
.gh_token.txt
.gh_device_state.json
.claude/
.DS_Store
Thumbs.db
desktop.ini

# Token / state written by the device-flow helper
.release.json
.release.out
.repo.json

# Local verification scratch (raw copies pulled back from the remote)
.verify/
